{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "types": [],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "index.js"],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "android",
    "ios",
    "**/*.test.ts"
  ]
}
